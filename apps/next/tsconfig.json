{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@pivot/app": ["../../packages/app/index.ts"],
      "@pivot/app/*": ["../../packages/app/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "plugins": [{ "name": "next" }],
    "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
