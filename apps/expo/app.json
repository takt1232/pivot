{
  "expo": {
    "name": "Pivot",
    "slug": "pivot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pivot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pivot.app"
    },
    "android": {
      "package": "com.pivot.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router"]
  }
}
